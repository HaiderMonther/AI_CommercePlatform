// AI Commerce Platform - Prisma schema
//
// Multi-tenancy model: shared database / shared schema, discriminated by `companyId`.
// Every tenant-owned table carries `companyId` and is indexed by it. Isolation is enforced
// in three layers: (1) JWT carries companyId, (2) a Prisma client extension injects the
// tenant filter into every query, (3) composite unique keys are always scoped by companyId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PlanTier {
  BASIC
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
}

enum ChannelStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum ConversationMode {
  AI
  HUMAN
}

enum SenderType {
  CUSTOMER
  AI
  AGENT
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  FILE
  LOCATION
  SYSTEM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  RETURNED
  FAILED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BANK_TRANSFER
  ZAIN_CASH
  ASIA_HAWALA
  FIB
  CARD
  OTHER
}

enum OrderSource {
  AI
  AGENT
  DASHBOARD
  API
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  SALE
  RETURN
  RESERVATION
  RELEASE
}

enum NotificationType {
  NEW_ORDER
  ORDER_STATUS_CHANGED
  NEW_CUSTOMER
  LOW_STOCK
  NEW_CONVERSATION
  HUMAN_HANDOVER
  CHANNEL_ERROR
  SYSTEM
}

enum UsageMetric {
  AI_MESSAGES
  AI_TOKENS
  MESSAGES_SENT
  MESSAGES_RECEIVED
  ORDERS
  USERS
  PRODUCTS
  CHANNELS
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model Company {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  logoUrl     String?
  phone       String?
  email       String?
  address     String?
  city        String?
  country     String        @default("IQ")
  currency    String        @default("IQD")
  timezone    String        @default("Asia/Baghdad")
  locale      String        @default("ar")
  status      CompanyStatus @default(TRIAL)
  planTier    PlanTier      @default(BASIC)
  trialEndsAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  users              User[]
  roles              Role[]
  categories         Category[]
  products           Product[]
  productVariants    ProductVariant[]
  inventoryMovements InventoryMovement[]
  customers          Customer[]
  conversations      Conversation[]
  messages           Message[]
  orders             Order[]
  channels           ChannelConnection[]
  aiConfig           AiConfig?
  aiInteractions     AiInteraction[]
  subscriptions      Subscription[]
  invoices           Invoice[]
  usageRecords       UsageRecord[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  webhookEvents      WebhookEvent[]

  @@index([status])
  @@index([createdAt])
  @@map("companies")
}

model User {
  id              String     @id @default(cuid())
  companyId       String?
  email           String
  phone           String?
  passwordHash    String
  fullName        String
  avatarUrl       String?
  status          UserStatus @default(ACTIVE)
  isPlatformAdmin Boolean    @default(false)
  roleId          String?
  lastLoginAt     DateTime?
  locale          String     @default("ar")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  company               Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role                  Role?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  assignedConversations Conversation[]       @relation("ConversationAssignee")
  sentMessages          Message[]            @relation("MessageAgent")
  inventoryMovements    InventoryMovement[]
  createdOrders         Order[]              @relation("OrderCreatedBy")
  orderStatusChanges    OrderStatusHistory[]
  notifications         Notification[]

  // Email is unique per tenant; platform users (companyId = null) are unique by a partial index
  // created in a migration, since Postgres treats NULLs as distinct in composite unique keys.
  @@unique([companyId, email])
  @@index([companyId, status])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  familyId   String
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(cuid())
  companyId   String?
  key         String
  name        String
  nameAr      String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([companyId, key])
  @@index([companyId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  group       String
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  companyId   String
  parentId    String?
  name        String
  slug        String
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, slug])
  @@index([companyId, isActive])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id                String    @id @default(cuid())
  companyId         String
  categoryId        String?
  name              String
  sku               String
  description       String?
  price             Decimal   @db.Decimal(14, 3)
  salePrice         Decimal?  @db.Decimal(14, 3)
  costPrice         Decimal?  @db.Decimal(14, 3)
  currency          String    @default("IQD")
  stock             Int       @default(0)
  reservedStock     Int       @default(0)
  lowStockThreshold Int       @default(5)
  trackInventory    Boolean   @default(true)
  hasVariants       Boolean   @default(false)
  tags              String[]  @default([])
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  variants           ProductVariant[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]

  @@unique([companyId, sku])
  @@index([companyId, isActive])
  @@index([companyId, categoryId])
  @@index([companyId, name])
  @@index([companyId, createdAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id            String    @id @default(cuid())
  companyId     String
  productId     String
  sku           String
  name          String
  // Normalized option values, e.g. { "color": "أسود", "size": "L" }
  attributes    Json      @default("{}")
  price         Decimal?  @db.Decimal(14, 3)
  salePrice     Decimal?  @db.Decimal(14, 3)
  costPrice     Decimal?  @db.Decimal(14, 3)
  stock         Int       @default(0)
  reservedStock Int       @default(0)
  imageUrl      String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]

  @@unique([companyId, sku])
  @@index([productId, isActive])
  @@index([companyId])
  @@map("product_variants")
}

model InventoryMovement {
  id             String                @id @default(cuid())
  companyId      String
  productId      String
  variantId      String?
  type           InventoryMovementType
  quantity       Int
  quantityBefore Int
  quantityAfter  Int
  unitCost       Decimal?              @db.Decimal(14, 3)
  reason         String?
  referenceType  String?
  referenceId    String?
  userId         String?
  createdAt      DateTime              @default(now())

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([productId, createdAt])
  @@index([variantId])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Customer {
  id              String         @id @default(cuid())
  companyId       String
  name            String
  phone           String?
  altPhone        String?
  email           String?
  address         String?
  city            String?
  notes           String?
  tags            String[]       @default([])
  status          CustomerStatus @default(ACTIVE)
  totalOrders     Int            @default(0)
  totalSpent      Decimal        @default(0) @db.Decimal(14, 3)
  outstandingDebt Decimal        @default(0) @db.Decimal(14, 3)
  lastOrderAt     DateTime?
  lastContactAt   DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  identities    CustomerIdentity[]
  conversations Conversation[]
  orders        Order[]

  @@unique([companyId, phone])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, name])
  @@map("customers")
}

// A single customer can reach the merchant from several platforms; identities keep the
// platform-specific handles without duplicating the customer record.
model CustomerIdentity {
  id             String      @id @default(cuid())
  companyId      String
  customerId     String
  channel        ChannelType
  platformUserId String
  displayName    String?
  profileUrl     String?
  createdAt      DateTime    @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([companyId, channel, platformUserId])
  @@index([customerId])
  @@map("customer_identities")
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

model ChannelConnection {
  id            String        @id @default(cuid())
  companyId     String
  type          ChannelType
  name          String
  // Provider account identity: WhatsApp phone_number_id, FB page id, IG account id
  externalId    String
  status        ChannelStatus @default(DISCONNECTED)
  // Encrypted at rest by the application (AES-256-GCM), never returned by the API
  credentials   Json?
  webhookSecret String?
  lastError     String?
  lastSyncAt    DateTime?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([type, externalId])
  @@index([companyId, type])
  @@map("channel_connections")
}

model WebhookEvent {
  id              String             @id @default(cuid())
  companyId       String?
  channel         ChannelType
  externalEventId String
  signatureValid  Boolean            @default(false)
  payload         Json
  status          WebhookEventStatus @default(RECEIVED)
  attempts        Int                @default(0)
  error           String?
  processedAt     DateTime?
  createdAt       DateTime           @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([channel, externalEventId])
  @@index([status, createdAt])
  @@map("webhook_events")
}

model Conversation {
  id             String             @id @default(cuid())
  companyId      String
  customerId     String
  channelId      String?
  channel        ChannelType
  status         ConversationStatus @default(OPEN)
  mode           ConversationMode   @default(AI)
  assignedUserId String?
  subject        String?
  unreadCount    Int                @default(0)
  handoverReason String?
  handoverAt     DateTime?
  lastMessageAt  DateTime?
  closedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channelConn    ChannelConnection? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  assignedUser   User?              @relation("ConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages       Message[]
  orders         Order[]
  aiInteractions AiInteraction[]

  @@index([companyId, status, lastMessageAt])
  @@index([companyId, assignedUserId])
  @@index([customerId])
  @@map("conversations")
}

model Message {
  id             String                @id @default(cuid())
  companyId      String
  conversationId String
  senderType     SenderType
  senderUserId   String?
  direction      MessageDirection
  type           MessageType           @default(TEXT)
  content        String
  mediaUrl       String?
  metadata       Json?
  externalId     String?
  deliveryStatus MessageDeliveryStatus @default(PENDING)
  failureReason  String?
  createdAt      DateTime              @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation  Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser    User?          @relation("MessageAgent", fields: [senderUserId], references: [id], onDelete: SetNull)
  aiInteraction AiInteraction?

  @@unique([companyId, externalId])
  @@index([conversationId, createdAt])
  @@index([companyId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// AI
// ---------------------------------------------------------------------------

model AiConfig {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  enabled             Boolean  @default(true)
  businessName        String?
  businessDescription String?
  tone                String   @default("friendly")
  language            String   @default("ar-IQ")
  currency            String   @default("IQD")
  workingHours        Json?
  returnPolicy        String?
  deliveryPolicy      String?
  paymentMethods      String[] @default([])
  customInstructions  String?
  model               String   @default("claude-sonnet-5")
  temperature         Float    @default(0.3)
  maxTokens           Int      @default(1024)
  autoReply           Boolean  @default(true)
  handoverKeywords    String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("ai_configs")
}

model AiInteraction {
  id               String   @id @default(cuid())
  companyId        String
  conversationId   String?
  messageId        String?  @unique
  intent           String?
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  latencyMs        Int      @default(0)
  toolCalls        Json?
  success          Boolean  @default(true)
  error            String?
  createdAt        DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([conversationId])
  @@map("ai_interactions")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id              String         @id @default(cuid())
  companyId       String
  orderNumber     Int
  customerId      String
  conversationId  String?
  source          OrderSource    @default(DASHBOARD)
  status          OrderStatus    @default(NEW)
  paymentStatus   PaymentStatus  @default(UNPAID)
  deliveryStatus  DeliveryStatus @default(PENDING)
  paymentMethod   PaymentMethod  @default(CASH_ON_DELIVERY)
  currency        String         @default("IQD")
  subtotal        Decimal        @db.Decimal(14, 3)
  discount        Decimal        @default(0) @db.Decimal(14, 3)
  deliveryFee     Decimal        @default(0) @db.Decimal(14, 3)
  total           Decimal        @db.Decimal(14, 3)
  paidAmount      Decimal        @default(0) @db.Decimal(14, 3)
  customerName    String
  customerPhone   String
  deliveryAddress String?
  deliveryCity    String?
  notes           String?
  createdByUserId String?
  confirmedAt     DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  conversation  Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdByUser User?                @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status, createdAt])
  @@index([companyId, createdAt])
  @@index([customerId])
  @@index([conversationId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  companyId   String
  orderId     String
  productId   String?
  variantId   String?
  productName String
  variantName String?
  sku         String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(14, 3)
  discount    Decimal  @default(0) @db.Decimal(14, 3)
  total       Decimal  @db.Decimal(14, 3)
  createdAt   DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  companyId  String
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  userId     String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Billing & usage
// ---------------------------------------------------------------------------

model Plan {
  id           String   @id @default(cuid())
  tier         PlanTier @unique
  name         String
  nameAr       String
  priceMonthly Decimal  @db.Decimal(14, 3)
  currency     String   @default("USD")
  // { AI_MESSAGES: 1000, USERS: 3, PRODUCTS: 500, CHANNELS: 1 }  (-1 = unlimited)
  limits       Json     @default("{}")
  features     String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  companyId          String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@index([companyId, status])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(cuid())
  companyId      String
  subscriptionId String?
  number         String        @unique
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("USD")
  subtotal       Decimal       @db.Decimal(14, 3)
  total          Decimal       @db.Decimal(14, 3)
  periodStart    DateTime
  periodEnd      DateTime
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@map("invoices")
}

// Daily usage counters, aggregated per company and metric.
model UsageRecord {
  id        String      @id @default(cuid())
  companyId String
  metric    UsageMetric
  period    String // YYYY-MM-DD
  value     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, metric, period])
  @@index([companyId, period])
  @@map("usage_records")
}

// ---------------------------------------------------------------------------
// Platform services
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  companyId String
  userId    String?
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, readAt])
  @@index([companyId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(cuid())
  companyId     String?
  userId        String?
  action        String
  entity        String
  entityId      String?
  oldValue      Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  createdAt     DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}
