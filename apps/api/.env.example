# ---------------------------------------------------------------------------
# AI Commerce Platform - API environment
# Copy to .env and fill in. Never commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database ------------------------------------------------------------------
DATABASE_URL=postgresql://aicommerce:aicommerce@localhost:5432/ai_commerce?schema=public

# Redis (caching, rate limiting, BullMQ queues) ------------------------------
REDIS_URL=redis://localhost:6379

# Auth ----------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=ai-commerce-platform

# Encryption key for channel credentials at rest (openssl rand -base64 32) ----
ENCRYPTION_KEY=change-me-to-a-long-random-string-min-32-chars

# CORS / URLs ---------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Rate limiting -------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10

# Observability -------------------------------------------------------------
LOG_LEVEL=log
SWAGGER_ENABLED=true

# Meta (WhatsApp / Instagram / Messenger) - used from Phase 5 ----------------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# AI provider - used from Phase 6 -------------------------------------------
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# Seed ----------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@ai-commerce.iq
SEED_SUPER_ADMIN_PASSWORD=Admin@12345
