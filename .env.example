# ---------------------------------------------------------------------------
# docker compose environment. Copy to .env before `docker compose up -d`.
# Generate each secret with: openssl rand -base64 48
# ---------------------------------------------------------------------------

# Database
POSTGRES_USER=aicommerce
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=ai_commerce
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Ports exposed on the host
API_PORT=3000
WEB_PORT=8080

# Auth secrets (required - compose refuses to start without them)
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Encryption key for channel credentials at rest
ENCRYPTION_KEY=change-me-to-a-long-random-string-min-32-chars

# URLs
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=/api/v1
SWAGGER_ENABLED=true

# Platform admin created by the migrate service on first boot
SEED_SUPER_ADMIN_EMAIL=admin@ai-commerce.iq
SEED_SUPER_ADMIN_PASSWORD=Admin@12345

# Meta channels (Phase 5)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# AI provider (Phase 6)
AI_API_KEY=
